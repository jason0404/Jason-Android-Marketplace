{
  "_note": "Claude Code plugins/marketplaces are not enabled from repository-root claude.json. Copy the settings below into your consuming Android project's .claude/settings.json after replacing the GitHub repository placeholder.",
  "copy_to": ".claude/settings.json",
  "extraKnownMarketplaces": {
    "jason-android-plugins": {
      "source": {
        "source": "github",
        "repo": "YOUR_GITHUB_USERNAME/YOUR_REVIEWER_MARKETPLACE_REPO"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "android-review@jason-android-plugins": true,
    "android-localization-toolkit@jason-android-plugins": true,
    "android-artifact-inspector@jason-android-plugins": true
  }
}
